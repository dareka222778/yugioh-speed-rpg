{
  "name": "yugioh-speed-rpg",
  "version": "0.12.0",
  "private": true,
  "description": "Discord RPG bot inspired by Yu-Gi-Oh! Speed Duel",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "progress": "node scripts/project-progress.cjs",
    "audit:engine": "node scripts/audit-duel-engine.cjs --games 300",
    "check:cards": "node scripts/check-card-certification.cjs",
    "coverage:engine": "node scripts/engine-coverage.cjs",
    "accept:engine": "npm run build && node scripts/accept-engine.cjs",
    "audit:tag": "npm run build && node scripts/audit-tag.cjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "discord.js": "^14.19.3",
    "dotenv": "^16.5.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "sharp@0.34.5": true,
    "esbuild@0.28.2": true
  }
}
